---
import Icon from '../components/Icon.astro';
import Text from '../components/Text.astro';
import Base from '../layouts/Base.astro';
import { projects } from '../lib/build-data';
import { CENTRED, featuredOf, fingerprint, photoPosStyle } from '../lib/content';
import { coverImages, imgAttrs, responsive } from '../lib/images';
import { cardHTML } from '../lib/render';
import { tl } from '../lib/t';
import { site } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const featured = featuredOf(projects);
const leaf = `${base}brand/leaf-light.png`;
const aboutPhoto = site.aboutPhoto || site.photo;
const aboutPos = photoPosStyle(site.aboutPhoto ? site.aboutPhotoPos : CENTRED);
// Smaller copies for the screen size (the original stays in data-photo).
const heroImg = await responsive(site.photo, [400, 600, 800, 1100], '(min-width: 900px) 560px, 88vw');
const spotImg = await responsive(aboutPhoto, [100, 200], '84px');
const aboutImg = await responsive(aboutPhoto, [480, 800, 1200], '(min-width: 900px) 460px, 92vw');
const covers = await coverImages(featured, '(min-width: 700px) 46vw, 92vw');
const photoAlt = `Photo of ${site.owner || 'the founder of Trutech Business'}`;
const chips = tl('home.about.chips');
---
<Base>
  {/* Hero: the layout of the Kontour Studios reference. Title and buttons
      top left, a card and two numbers top right, the cut-out photo standing
      in the middle in front of a giant wordmark, with an orange glow. */}
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <Text as="p" class="eyebrow" k="home.badge" data-intro="line" />
        <Text as="h1" k="home.title" data-intro="line" />
        <Text as="p" class="sub" k="home.sub" data-intro="line" />
        <div class="ctas" data-intro="line">
          <a class="btn btn-primary" href={base + 'contact/'}><Text k="home.ctaHire" /> <Icon name="arrow-up-right" /></a>
          <a class="btn btn-ghost" href={base + 'work/'}><Text k="home.ctaWork" /></a>
        </div>
      </div>

      <aside class="hero-side" data-intro="right">
        <a class="spot" href={base + 'about/'}>
          <span class:list={['spot-img placed', { 'has-photo': aboutPhoto }]} data-photo-slot="about" data-photo={aboutPhoto} data-fallback={leaf} style={aboutPos}>
            <img {...(aboutPhoto ? imgAttrs(spotImg) : { src: leaf })} alt="" width="84" height="96" decoding="async" />
          </span>
          <span class="spot-text">
            <Text as="strong" k="home.proofTitle" />
            <Text as="small" k="home.proofText" />
          </span>
          <span class="spot-go" aria-hidden="true"><span></span><span></span><Icon name="arrow-up-right" size={14} /></span>
        </a>
        <dl class="hero-stats">
          {
            [1, 2].map((n) => (
              <div>
                <dt class="hs-v"><Text k={`stat.${n}.value`} />+</dt>
                <dd><Text k={`stat.${n}.label`} /></dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    <div class="stage">
      <p class="wordmark" aria-hidden="true"><Text k="home.wordmark" data-intro="word" /></p>
      <span class="glow" aria-hidden="true" data-intro="photo"></span>
      <div class:list={['arch', { 'has-photo': site.photo }]} data-photo-slot data-photo={site.photo} data-fallback={leaf}>
        <span class="lift"><img {...(site.photo ? imgAttrs(heroImg) : { src: leaf })} alt={site.photo ? photoAlt : ''} width="560" height="700" fetchpriority="high" /></span>
      </div>
      <script is:inline>
        // Shows the photo as soon as the early settings request (Base.astro)
        // confirms it's still the current one, without waiting for the
        // page's scripts. Anything else is left to src/scripts/profile.ts.
        (function () {
          var slot = document.currentScript.previousElementSibling;
          if (!window.__settings) return;
          window.__settings.then(function (rows) {
            var d = (rows && rows[0] && rows[0].data) || null;
            if (d && (d.photo || '') === (slot.dataset.photo || '')) slot.classList.add('photo-ready');
          });
        })();
      </script>
    </div>
  </section>

  {/* Services */}
  <section class="section" id="services">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <Text as="p" class="eyebrow" k="home.services.label" />
          <Text as="h2" k="home.services.title" />
        </div>
        <a class="pill-link" href={base + 'services/'}><Text k="home.services.more" /><span class="pill-arrow"><Icon name="arrow" size={18} /></span></a>
      </div>
      <div class="svc-list">
        {
          site.services.map((s, i) => (
            <details class="svc reveal" name="services" open={i === 0}>
              <summary>
                <span class="svc-n">{String(i + 1).padStart(2, '0')}.</span>
                <Text class="svc-title" k={`service.${i + 1}.title`} />
                <span class="arrow-badge" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
              </summary>
              <div class="svc-body">
                <ul class="svc-tags">{s.points.map((pt) => <li>{pt}</li>)}</ul>
                <Text as="p" k={`service.${i + 1}.text`} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* About */}
  <section class="section about">
    <div class="container about-grid">
      <div class="about-card reveal" aria-hidden={aboutPhoto ? undefined : 'true'}>
        <div class:list={['about-photo placed', { 'has-photo': aboutPhoto }]} data-photo-slot="about" data-photo={aboutPhoto} data-fallback={leaf} style={aboutPos}>
          <img {...(aboutPhoto ? imgAttrs(aboutImg) : { src: leaf })} alt={aboutPhoto ? photoAlt : ''} width="460" height="518" loading="lazy" decoding="async" />
        </div>
        {chips.map((c, i) => <span class:list={['float-chip', i % 2 ? 'two' : 'one']} data-intro="chip">{c}</span>)}
      </div>
      <div class="about-text reveal">
        <Text as="p" class="eyebrow" k="home.about.label" />
        <Text as="h2" k="home.about.title" />
        <Text as="p" class="lead" k="home.about.text" />
        <div class="stats">
          {
            site.about.stats.map((_, i) => (
              <div class="stat">
                <span class="stat-v"><Text k={`stat.${i + 1}.value`} />+</span>
                <Text class="muted" k={`stat.${i + 1}.label`} />
              </div>
            ))
          }
        </div>
        <div class="about-actions">
          <a class="btn btn-primary" href={base + 'about/'}><Text k="home.about.more" /> <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={base + 'contact/'}><Text k="home.about.contact" /></a>
        </div>
      </div>
    </div>
  </section>

  {/* Selected work */}
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <Text as="p" class="eyebrow" k="home.work.label" />
          <Text as="h2" k="home.work.title" />
        </div>
        <a class="pill-link" href={base + 'work/'}><Text k="home.work.more" /><span class="pill-arrow"><Icon name="arrow" size={18} /></span></a>
      </div>
      <div class="grid grid-2" data-featured data-fp={fingerprint(featured)} set:html={featured.map((p, i) => cardHTML(p, i, base, covers)).join('')} />
    </div>
  </section>

  {/* Process */}
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <Text as="p" class="eyebrow" k="home.process.label" />
          <Text as="h2" k="home.process.title" />
        </div>
      </div>
      <ol class="grid grid-4 steps">
        {
          site.process.map((_, i) => (
            <li class:list={['step reveal', { on: i === 0 }]} style={`transition-delay:${i * 80}ms`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <Text as="h3" k={`process.${i + 1}.title`} />
              <Text as="p" k={`process.${i + 1}.text`} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    site.testimonials.length > 0 && (
      <section class="section">
        <div class="container grid grid-3">
          {site.testimonials.map((t) => (
            <figure class="card reveal">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                <strong>{t.name}</strong>
                <span class="muted"> · {t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {/* CTA */}
  <section class="cta-band">
    <div class="container cta reveal">
      <Text as="h2" k="home.cta.title" />
      <Text as="p" k="home.cta.text" />
      <a class="btn cta-btn" href={base + 'contact/'}><Text k="home.cta.button" /> <span class="cta-arrow"><Icon name="arrow" size={18} /></span></a>
    </div>
  </section>
</Base>

<script>
  import { liveFeatured } from '../scripts/live';
  import { heroPhoto, homeMotion } from '../scripts/motion';
  import { liveProfilePhoto } from '../scripts/profile';
  liveFeatured(document.querySelector<HTMLElement>('[data-featured]')!).catch(() => {});
  homeMotion();
  liveProfilePhoto()
    .catch(() => {})
    .finally(heroPhoto);
</script>

<style>
  /* ---- Hero ---- */
  /* The photo, glow and wordmark fill the section; the text sits on top. */
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
    /* Runs up under the clear header, so the glow reaches the top. */
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    min-height: clamp(640px, 100svh, 940px);
    background:
      radial-gradient(46% 64% at 18% 50%, var(--glow), transparent 72%),
      radial-gradient(30% 52% at 50% 80%, var(--glow), transparent 72%),
      var(--bg);
  }
  .hero-grid,
  .stage {
    grid-area: 1 / 1;
  }
  .hero-grid {
    position: relative;
    z-index: 3;
    align-self: start;
    display: grid;
    grid-template-columns: minmax(0, 420px) 1fr minmax(0, 300px);
    align-items: start;
    padding-top: clamp(28px, 6vh, 64px);
  }
  .hero-copy {
    grid-column: 1;
  }
  .hero-side {
    grid-column: 3;
    display: grid;
    gap: 28px;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 4.6vw, 4.1rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: 14px;
  }
  .sub {
    margin: 0 0 26px;
    max-width: 34ch;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ctas .btn {
    min-height: 46px;
    font-size: 0.88rem;
  }

  /* Card on the right ("Recognition" in the reference). */
  .spot {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 14px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .spot:hover {
    border-color: var(--amber);
  }
  .spot-img {
    grid-row: span 2;
    position: relative;
    display: grid;
    place-items: center;
    height: 96px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--amber);
  }
  .spot-img:not(.has-photo) img {
    width: 60%;
  }
  .spot-text {
    display: grid;
    align-content: start;
    gap: 4px;
    padding-top: 4px;
  }
  .spot-text :global(strong) {
    font-size: 0.92rem;
    line-height: 1.3;
  }
  .spot-text :global(small) {
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.4;
  }
  .spot-go {
    grid-column: 2;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .spot-go span {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--text-muted);
  }
  .spot-go span:first-child {
    width: 18px;
    background: var(--text);
  }
  .spot-go :global(svg) {
    box-sizing: content-box;
    padding: 6px;
    border-radius: 99px;
    background: var(--amber);
    color: var(--ink);
  }
  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 0;
  }
  .hs-v {
    font: 400 clamp(2.4rem, 3.6vw, 3.2rem) / 1.1 var(--font-display);
    letter-spacing: -0.04em;
  }
  .hero-stats dd {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.4;
  }

  /* Photo, glow and the giant word behind the photo. */
  .stage {
    position: relative;
    z-index: 1;
    min-height: 0;
  }
  .wordmark {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 0.02em;
    transform: translateX(-50%);
    margin: 0;
    font: 700 clamp(4.5rem, 19.6vw, 17.5rem) / 0.8 var(--font-display);
    letter-spacing: -0.05em;
    white-space: nowrap;
    color: var(--text);
    pointer-events: none;
    user-select: none;
  }
  .wordmark :global(span) {
    display: inline-block;
  }
  /* A soft orange light right behind the photo (breathes; motion.ts). */
  .glow {
    position: absolute;
    z-index: 0;
    bottom: 6%;
    left: 50%;
    width: min(70vw, 720px);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 999px;
    background: radial-gradient(closest-side, rgb(254 81 1 / 0.75), rgb(254 81 1 / 0.25) 55%, transparent);
    filter: blur(28px);
    pointer-events: none;
  }
  /* The cut-out photo stands on the bottom edge, in front of the word, with
     no frame. A photo with a transparent background looks best; without a
     photo the leaf stands there. */
  .arch {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 90%;
    max-width: 92%;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    /* As the photo drifts down on scroll (motion.ts), it sinks out of sight
       at the bottom edge. */
    overflow: hidden;
    overflow: clip;
  }
  .arch img {
    width: 40%;
    height: auto;
  }
  .arch.has-photo {
    align-items: flex-end;
  }
  .arch.has-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }
  /* The photo rises into place once it's confirmed as the current one. */
  @media (prefers-reduced-motion: no-preference) {
    .js .arch.photo-ready img {
      animation: photo-rise 0.9s cubic-bezier(0.2, 1.25, 0.35, 1) both;
    }
  }
  @keyframes photo-rise {
    from {
      opacity: 0;
      transform: translateY(60px) scale(0.94);
    }
  }
  /* Moves the photo on scroll (src/scripts/motion.ts). */
  .lift {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: inherit;
    justify-content: center;
  }

  /* Tablets and phones: title and buttons, then the photo on the word, then
     the card and numbers. */
  @media (max-width: 899px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
      background:
        radial-gradient(70% 40% at 20% 18%, var(--glow), transparent 72%),
        radial-gradient(60% 34% at 50% 62%, var(--glow), transparent 72%),
        var(--bg);
    }
    .hero-grid {
      display: contents;
    }
    .hero-copy,
    .hero-side {
      width: min(100% - 2 * var(--gutter), var(--max));
      margin-inline: auto;
      position: relative;
      z-index: 3;
    }
    .hero-copy {
      order: 1;
      padding-top: 28px;
    }
    .stage {
      order: 2;
      min-height: 0;
      padding-top: 0;
      height: clamp(400px, 118vw, 620px);
      margin-top: -8px;
    }
    .hero-side {
      order: 3;
      padding-block: 28px 8px;
      grid-template-columns: 1fr;
    }
    .wordmark {
      font-size: 19.5vw;
    }
    .glow {
      width: 110vw;
    }
  }
  @media (min-width: 560px) and (max-width: 899px) {
    .hero-side {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
    }
  }

  /* ---- Pill link ("View all") ---- */
  .pill-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .pill-link > span:first-child {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--amber);
    color: var(--ink);
  }
  .pill-arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    transition: transform 0.25s var(--ease);
  }
  .pill-link:hover .pill-arrow {
    transform: translateX(3px);
  }

  /* ---- Services accordion ---- */
  .svc-list {
    display: grid;
    gap: 12px;
  }
  .svc {
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .svc summary {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px 18px 14px 24px;
    cursor: pointer;
    list-style: none;
  }
  .svc summary::-webkit-details-marker {
    display: none;
  }
  @media (min-width: 900px) {
    .svc summary {
      grid-template-columns: 200px 1fr auto;
      padding-left: 32px;
    }
    .svc-body {
      padding-left: 232px !important;
    }
  }
  .svc-n {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .svc-title {
    font: 600 clamp(1.1rem, 2vw, 1.4rem) / 1.25 var(--font-display);
  }
  .svc summary:hover .svc-title {
    color: var(--accent);
  }
  .svc-body {
    padding: 0 24px 26px 92px;
  }
  .svc-body p {
    margin: 14px 0 0;
    max-width: 62ch;
  }
  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .svc-tags li {
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid currentColor;
    font-size: 0.8rem;
    font-weight: 600;
  }
  /* The open service turns amber with dark text. */
  .svc[open] {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--ink);
  }
  .svc[open] .svc-n,
  .svc[open] summary:hover .svc-title {
    color: var(--ink);
  }
  .svc[open] .arrow-badge {
    background: var(--ink);
    color: var(--white);
    transform: rotate(90deg);
  }
  @media (max-width: 600px) {
    .svc summary {
      grid-template-columns: 34px 1fr auto;
      padding-left: 18px;
    }
    .svc-body {
      padding: 0 18px 22px;
    }
  }

  /* ---- About ---- */
  .about-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(320px, 460px) 1fr;
      gap: 72px;
    }
  }
  .about-card {
    position: relative;
    aspect-ratio: 8 / 9;
    border-radius: var(--radius-lg);
    background: var(--amber);
    overflow: hidden;
  }
  /* The About photo fills the card, placed as set in the admin. Without a
     photo the leaf sits in the middle of the card. */
  .about-photo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .about-photo:not(.has-photo) img {
    width: 34%;
    height: auto;
  }
  .float-chip {
    position: absolute;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .float-chip.one {
    left: 6%;
    top: 62%;
    transform: rotate(8deg);
  }
  .float-chip.two {
    right: 6%;
    top: 76%;
    transform: rotate(-8deg);
  }
  .about-text .lead {
    max-width: 62ch;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 28px 0;
  }
  .stat {
    display: grid;
    gap: 2px;
    padding: 18px 20px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .stat .muted {
    font-size: 0.85rem;
  }
  .stat-v {
    font: 700 clamp(1.8rem, 3vw, 2.3rem) / 1.25 var(--font-display);
    color: var(--accent);
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 520px) {
    .stats {
      gap: 8px;
    }
    .stat {
      padding: 14px 12px;
    }
    .stat .muted {
      font-size: 0.75rem;
    }
  }

  /* ---- Process ---- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    padding: 26px;
    border-radius: 22px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .step p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .num {
    display: block;
    font: 700 2.6rem/1.2 var(--font-display);
    color: var(--accent);
    margin-bottom: 18px;
  }
  .step.on {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--ink);
  }
