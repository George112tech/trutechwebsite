---
import { site, whatsappLink } from '../site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Text from './Text.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div class="brand">
      <Logo lazy />
      <Text as="p" class="muted" k="brand.tagline" />
      {
        site.socials.length > 0 && (
          <ul class="socials" aria-label="Social media">
            {site.socials.map((s) => (
              <li>
                <a href={s.url} rel="me noopener" target="_blank" aria-label={`${s.label}: ${s.handle}`}>
                  <Icon name={s.icon} size={18} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <nav aria-label="Footer">
      <Text as="h2" class="h" k="footer.explore" />
      <ul>
        <li><a href={base + 'work/'}><Text k="nav.work" /></a></li>
        <li><a href={base + 'services/'}><Text k="nav.services" /></a></li>
        <li><a href={base + 'about/'}><Text k="nav.about" /></a></li>
        <li><a href={base + 'contact/'}><Text k="nav.contact" /></a></li>
      </ul>
    </nav>
    <div>
      <Text as="h2" class="h" k="footer.contact" />
      <ul>
        {site.email && <li><a href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a></li>}
        {site.phone && <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" size={18} /> {site.phone}</a></li>}
        {whatsappLink() && <li><a href={whatsappLink()}><Icon name="whatsapp" size={18} /> WhatsApp</a></li>}
        <li class="muted"><Icon name="pin" size={18} /> {site.location}</li>
      </ul>
    </div>
    {
      site.socials.length > 0 && (
        <div>
          <Text as="h2" class="h" k="footer.follow" />
          <ul>
            {site.socials.map((s) => (
              <li>
                <a href={s.url} rel="me noopener" target="_blank" aria-label={`${s.label}: ${s.handle}`}>
                  {s.label} {s.handle}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  <div class="container legal muted">
    <span>© {year} {site.brand}. <Text k="footer.rights" /></span>
    <nav class="legal-links" aria-label="Legal"><a href={base + 'terms/'}><Text k="footer.terms" /></a><a href={base + 'privacy/'}><Text k="footer.privacy" /></a></nav>
  </div>
  <p class="footer-word" aria-hidden="true"><Text k="home.wordmark" /></p>
</footer>
<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding-top: 64px;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }
  /* The brand word across the bottom, fading out of flame orange. */
  .footer-word {
    margin: 24px 0 -0.14em;
    text-align: center;
    font: 700 clamp(4.5rem, 19.6vw, 17.5rem) / 0.9 var(--font-display);
    letter-spacing: -0.05em;
    white-space: nowrap;
    background: linear-gradient(180deg, var(--amber), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    pointer-events: none;
    user-select: none;
  }
  .cols {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 820px) {
    .cols {
      grid-template-columns: 1.6fr 1fr 1.4fr 1fr;
    }
  }
  .brand p {
    margin: 16px 0 18px;
    max-width: 30ch;
  }
  .h {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  li,
  li a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  li a:hover {
    color: var(--accent);
  }
  .socials {
    display: flex;
    gap: 10px;
  }
  .socials a {
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .socials a:hover {
    border-color: var(--amber);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .legal-links {
    display: flex;
    gap: 20px;
  }
  .legal-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .legal-links a:hover {
    color: var(--accent);
  }
</style>
