---
// Page title area. eyebrow, title and lead are Site text keys; leadText
// replaces the lead with ready-made text (such as a date).
import Text from './Text.astro';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  leadText?: string;
}
const { eyebrow, title, lead, leadText } = Astro.props;
---
<section class="page-hero">
  <p class="wordmark" aria-hidden="true"><Text k="home.wordmark" /></p>
  <div class="container inner">
    <Text as="p" class="eyebrow" k={eyebrow} />
    <Text as="h1" k={title} />
    {leadText ? <p class="lead">{leadText}</p> : lead && <Text as="p" class="lead" k={lead} />}
    <slot />
  </div>
</section>
<style>
  /* As on the home page: an orange glow on the left, the title in white, and
     the giant brand word along the bottom edge, half out of sight. */
  .page-hero {
    position: relative;
    overflow: hidden;
    margin-top: calc(-1 * var(--header-h));
    padding-block: calc(var(--header-h) + clamp(48px, 8vw, 96px)) clamp(110px, 13vw, 200px);
    background:
      radial-gradient(48% 70% at 14% 45%, var(--glow), transparent 72%),
      radial-gradient(36% 60% at 70% 100%, var(--glow), transparent 72%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .wordmark {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 46%);
    margin: 0;
    font: 700 clamp(4.5rem, 19.6vw, 17.5rem) / 0.8 var(--font-display);
    letter-spacing: -0.05em;
    white-space: nowrap;
    color: var(--text);
    pointer-events: none;
    user-select: none;
  }
  .inner {
    position: relative;
    z-index: 1;
  }
  h1 {
    max-width: 16ch;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .lead {
    margin-bottom: 0;
  }
</style>
