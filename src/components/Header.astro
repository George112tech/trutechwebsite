---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Text from './Text.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(base, '/');
const links = [
  { href: '', key: 'nav.home' },
  { href: 'services/', key: 'nav.services' },
  { href: 'work/', key: 'nav.work' },
  { href: 'about/', key: 'nav.about' },
  { href: 'contact/', key: 'nav.contact' },
];
const current = (href: string) => (href ? path.startsWith('/' + href) : path === '/');
// Links either side of the logo, as in the design.
const left = links.slice(0, 3);
const right = links.slice(3);
---
<header class="site-header" data-header>
  <div class="container bar">
    <nav class="side-nav left" aria-label="Main">
      <ul>
        {
          left.map((l) => (
            <li>
              <a href={base + l.href} aria-current={current(l.href) ? 'page' : undefined}>
                <Text k={l.key} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={base} class="home" aria-label="Trutech Business home">
      <Logo />
    </a>
    <div class="right">
      <nav class="side-nav" aria-label="More">
        <ul>
          {
            right.map((l) => (
              <li>
                <a href={base + l.href} aria-current={current(l.href) ? 'page' : undefined}>
                  <Text k={l.key} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button class="icon-btn theme" type="button" aria-pressed="false" data-theme-toggle>
        <span class="to-light"><Icon name="sun" size={18} /></span>
        <span class="to-dark"><Icon name="moon" size={18} /></span>
        <span class="sr-only">Light mode</span>
      </button>
      <button class="icon-btn menu" type="button" aria-expanded="false" aria-controls="nav-links" data-menu>
        <span class="open"><Icon name="menu" size={20} label="Open menu" /></span>
        <span class="shut"><Icon name="close" size={20} label="Close menu" /></span>
      </button>
    </div>
    <!-- Phones: every link in one menu under the bar. -->
    <nav class="menu-nav" aria-label="Menu">
      <ul id="nav-links" data-nav>
        {
          links.map((l) => (
            <li>
              <a href={base + l.href} aria-current={current(l.href) ? 'page' : undefined}>
                <Text k={l.key} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const button = header.querySelector<HTMLButtonElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    button.setAttribute('aria-expanded', String(open));
  };
  button.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  header.querySelectorAll('[data-nav] a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Theme toggle (dark by default). The theme is applied before paint by Base.astro.
  const root = document.documentElement;
  const toggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const syncToggle = () => toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncToggle();
  });
  syncToggle();

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  // Checked on the next frame, so reading the scroll position doesn't force
  // a layout while the page is still being set up.
  requestAnimationFrame(onScroll);
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  /* A thin bar across the top: links either side of the logo in the middle.
     Clear over the page at the top, black once the page scrolls. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background-color 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .is-scrolled {
    background: var(--header-bg);
    border-bottom-color: var(--border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    min-height: var(--header-h);
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
  }
  .left li:first-child a {
    padding-left: 0;
  }
  ul a:hover,
  ul a[aria-current='page'] {
    color: var(--accent);
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .icon-btn:hover {
    color: var(--accent);
  }
  .theme .to-dark,
  :global([data-theme='light']) .theme .to-light {
    display: none;
  }
  :global([data-theme='light']) .theme .to-dark {
    display: inline;
  }
  .menu,
  .menu-nav {
    display: none;
  }
  .menu {
    background: var(--amber);
    color: var(--ink);
  }
  .menu:hover {
    color: var(--ink);
    background: var(--amber-hover);
  }
  .menu .shut {
    display: none;
  }
  @media (max-width: 900px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    .side-nav {
      display: none;
    }
    .home {
      order: -1;
    }
    .menu {
      display: inline-grid;
    }
    .menu-nav {
      display: block;
      grid-column: 1 / -1;
    }
    .menu-nav ul {
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px;
      background: var(--menu-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
    }
    .is-open .menu-nav ul {
      display: flex;
    }
    .is-open .menu .open {
      display: none;
    }
    .is-open .menu .shut {
      display: inline;
    }
    .menu-nav a {
      min-height: 48px;
      padding: 0 16px;
      font-size: 0.9rem;
    }
    .menu-nav a[aria-current='page'] {
      background: var(--surface-2);
      border-radius: 12px;
    }
  }
</style>
